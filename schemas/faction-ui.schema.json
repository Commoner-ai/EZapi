{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EZapi faction presentation definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "chinese"
          ],
          "properties": {
            "chinese": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        {
          "required": [
            "english"
          ],
          "properties": {
            "english": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ],
      "properties": {
        "chinese": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        },
        "english": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "default": "#665867"
    },
    "order": {
      "type": "integer"
    },
    "minimum": {
      "type": "number",
      "minimum": -1000000,
      "exclusiveMaximum": 0,
      "default": -200
    },
    "maximum": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "default": 200
    }
  }
}
