{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ezapi.local/schemas/requirements",
  "title": "EZapi readonly requirements",
  "$ref": "#/$defs/node",
  "$defs": {
    "text": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"chinese": {"type": "string", "minLength": 1, "maxLength": 1000}, "english": {"type": "string", "minLength": 1, "maxLength": 1000}}
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["all", "any", "not", "upgrade-unlocked", "upgrade-ready", "service-unlocked", "service-introduced", "service-active", "service-off-cooldown", "day-at-least", "day-at-most", "credits-at-least"], "default": "all"},
        "targetId": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"},
        "amount": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "message": {"$ref": "#/$defs/text"},
        "children": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/node"}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"enum": ["all", "any", "not"]}}}, "then": {"not": {"anyOf": [{"required": ["targetId"]}, {"required": ["amount"]}]}}},
        {"if": {"required": ["kind"], "properties": {"kind": {"const": "any"}}}, "then": {"required": ["children"], "properties": {"children": {"minItems": 1}}}},
        {"if": {"required": ["kind"], "properties": {"kind": {"const": "not"}}}, "then": {"required": ["children"], "properties": {"children": {"minItems": 1, "maxItems": 1}}}},
        {"if": {"required": ["kind"], "properties": {"kind": {"enum": ["upgrade-unlocked", "upgrade-ready", "service-unlocked", "service-introduced", "service-active", "service-off-cooldown"]}}}, "then": {"required": ["targetId"], "not": {"required": ["amount"]}, "properties": {"children": {"maxItems": 0}}}},
        {"if": {"required": ["kind"], "properties": {"kind": {"enum": ["day-at-least", "day-at-most", "credits-at-least"]}}}, "then": {"required": ["amount"], "not": {"required": ["targetId"]}, "properties": {"children": {"maxItems": 0}}}}
      ]
    }
  }
}
